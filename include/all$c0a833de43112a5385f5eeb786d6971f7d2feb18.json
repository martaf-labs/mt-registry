                        "@php -r \"echo PHP_EOL . '========================================' . PHP_EOL . '  Projet cree avec succes !' . PHP_EOL . '========================================' . PHP_EOL . '  Lancez maintenant :' . PHP_EOL . '  php artisan mt:install' . PHP_EOL . PHP_EOL;\""
