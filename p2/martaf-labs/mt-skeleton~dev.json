{
    "packages": {
        "martaf-labs/mt-skeleton": [
            {
                "name": "martaf-labs/mt-skeleton",
                "version": "dev-main",
                "version_normalized": "dev-main",
                "source": {
                    "type": "git",
                    "url": "git@github.com:martaf-labs/mt-skeleton.git",
                    "reference": "0a5f50d99e9324287a62bcac51061569dd37e5e8"
                },
                "dist": {
                    "type": "zip",
                    "url": "https://martaf-labs.github.io/mt-registry/dist/martaf-labs/mt-skeleton/martaf-labs-mt-skeleton-0a5f50d99e9324287a62bcac51061569dd37e5e8-zip-1ff822.zip",
                    "reference": "0a5f50d99e9324287a62bcac51061569dd37e5e8",
                    "shasum": "0bb701c269dc539217d253cb15b6b64e52c80903"
                },
                "require": {
                    "laravel/fortify": "^1.0",
                    "laravel/framework": "^13.0",
                    "laravel/tinker": "^3.0",
                    "livewire/livewire": "^3.0",
                    "martaf-labs/mt-foundation": "dev-main",
                    "php": "^8.2"
                },
                "require-dev": {
                    "fakerphp/faker": "^1.24",
                    "laravel/pail": "^1.2",
                    "laravel/pint": "^1.0",
                    "laravel/sail": "^1.0",
                    "mockery/mockery": "^1.6",
                    "nunomaduro/collision": "^8.0",
                    "phpunit/phpunit": "^11.0"
                },
                "time": "2026-06-11T00:31:24+00:00",
                "default-branch": true,
                "type": "project",
                "extra": {
                    "laravel": {
                        "dont-discover": [],
                        "providers": [
                            "MtSkeleton\\MtSkeletonServiceProvider"
                        ]
                    }
                },
                "installation-source": "dist",
                "autoload": {
                    "psr-4": {
                        "App\\": "app/",
                        "Database\\Factories\\": "database/factories/",
                        "Database\\Seeders\\": "database/seeders/",
                        "MtSkeleton\\": "src/"
                    }
                },
                "autoload-dev": {
                    "psr-4": {
                        "Tests\\": "tests/"
                    }
                },
                "scripts": {
                    "post-autoload-dump": [
                        "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
                        "@php artisan package:discover --ansi"
                    ],
                    "post-update-cmd": [
                        "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
                    ],
                    "post-root-package-install": [
                        "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
                    ],
                    "post-create-project-cmd": [
                        "@php artisan key:generate --ansi",
                        "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
                        "@php artisan migrate --graceful --ansi",
                        "@php artisan mt:install"
                    ],
                    "dev": [
                        "Composer\\Config::disableProcessTimeout",
                        "npx concurrently -c \"#93c5fd,#c4b5fd,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"npm run dev\" --names=server,queue,vite --kill-others"
                    ],
                    "test": [
                        "@php artisan config:clear --ansi",
                        "@php artisan test"
                    ],
                    "lint": [
                        "pint --parallel"
                    ],
                    "lint:check": [
                        "pint --parallel --test"
                    ]
                },
                "license": [
                    "MIT"
                ],
                "authors": [
                    {
                        "name": "Djoukeng Brice Marcello",
                        "email": "djoukengbricemarcello@gmail.com"
                    }
                ],
                "description": "Skeleton officiel de l'écosystème martaf-labs. Permet de créer rapidement une application Laravel avec les modules mt-* souhaités.",
                "keywords": [
                    "ecosystem",
                    "laravel",
                    "martaf",
                    "skeleton",
                    "starter"
                ],
                "support": {
                    "source": "https://github.com/martaf-labs/mt-skeleton/tree/main",
                    "issues": "https://github.com/martaf-labs/mt-skeleton/issues"
                }
            }
        ]
    }
}
